---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const all = (await getCollection('partners')).sort(
  (a, b) => a.data.order - b.data.order
);
const sponsors = all.filter((p) => p.data.kind === 'sponsor');
const partners = all.filter((p) => p.data.kind === 'partner');
---

<Layout title="Partners & Sponsors">
  <h2 class="section-heading">Our Sponsors</h2>
  <div class="grid">
    {sponsors.map((s) => (
      <div class="card">
        <div class="logo" aria-hidden="true">
          {s.data.logo && <img src={s.data.logo} alt="" />}
        </div>
        <p class="name">{s.data.name}</p>
      </div>
    ))}
    {sponsors.length === 0 && <p class="empty">No sponsors added yet.</p>}
  </div>

  <h2 class="section-heading">Our Partners</h2>
  <div class="grid">
    {partners.map((p) => (
      <div class="card">
        <div class="logo" aria-hidden="true">
          {p.data.logo && <img src={p.data.logo} alt="" />}
        </div>
        <p class="name">{p.data.name}</p>
      </div>
    ))}
    {partners.length === 0 && <p class="empty">No partners added yet.</p>}
  </div>
</Layout>

<style>
  .section-heading {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #666;
    margin: 1.5rem 0 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }
  .card {
    border: 1px solid #e2e2e2;
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }
  .logo {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    background: #f0f0f0;
    overflow: hidden;
  }
  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .name {
    font-size: 13px;
    font-weight: 500;
    margin: 0;
  }
  .empty {
    grid-column: 1 / -1;
    font-size: 13px;
    color: #999;
  }
  /* NOTE: this is the collapsed-only version — add the same
     click-to-expand behavior as ExpandableRow when you're ready
     to show each partner's full blurb + socials + website link. */
</style>

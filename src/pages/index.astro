---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StemRail from '../components/StemRail.astro';

const partners = (await getCollection('partners')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Home">
  <!-- Hero: the stem sprouts out of the bottom of this block -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1>
          A box of science,<br />sent where there isn't one.
        </h1>
        <p class="hero-lede">
          We're a high school competitive robotics team building hands-on STEM kits and
          shipping them kids to give everyone the opportunity to experience STEM
        </p>
        <div class="hero-actions">
          <a class="button" href="/boxes">See what's in a box</a>
          <a class="button-quiet" href="#donate">Support a shipment</a>
        </div>
      </div>
    <div class="hero-photo-block">
      <div class="hero-photo">
        <img src="/team.png" alt="The STEM Seeds team" />
        </div>
      <p class="hero-photo-caption">Built by student engineers</p>
    </div>
  </div>
    <svg class="hero-sprout" viewBox="0 0 80 60" aria-hidden="true">
      <path d="M40 60V22" />
      <path d="M40 30c0-10 6-16 16-16 0 10-6 16-16 16Z" />
      <path d="M40 40c-8 0-13-5-13-13 8 0 13 5 13 13Z" />
    </svg>
  </section>

  <StemRail>
    <section class="stem-section split">
      <div class="split-text">
        <h2>Why we started</h2>
        <p class="prose">
          STEM is one of the most interesting fields in today's world. However, many people are unable to access or participate in STEM activities
          due to factors outside of their control. We started STEM Seeds to help deal with that issue
        </p>
        <p class="stat-line">
          Currently working with <strong>{partners.length}</strong>
          partner organization{partners.length === 1 ? '' : 's'} —
          <a href="#partners">see who they are</a>
        </p>
      </div>
      <div class="split-media">
        <div class="photo photo-lg">
          <img src="/about-people.png" alt="The STEM Seeds team at work" />
        </div>
        <div class="photo photo-sm">
          <img src="/about-bot.png" alt="A STEM Seeds robot the team built" />
        </div>
      </div>
    </section>

    <section class="stem-section split split-reverse">
      <div class="split-text">
        <h2>Who we are</h2>
        <p class="prose">
          32737 Vanguard is 
        </p>
      </div>
      <div class="split-media">
        <div class="photo photo-lg">
          <img src="/Vanguard.png" alt="Who we are" />
        </div>
      </div>
    </section>

    <section class="stem-section split captain-section">
  <div class="split-text">
    <h2>Meet the captain</h2>
    <p class="prose">
      I am an engineer and FTC team captain who as always loved building, designing, experimenting, 
      and figuring out how things work. I started STEM Seeds because I wanted other students to 
      have access to hands-on STEM learning, especially those might not otherwise have that opportunity. 
      More than just introducing students to STEM, I want to use STEM Seeds to give students something they can
      take further, turning their very first project into the curiosity and confidence to keep building and pursue their
      own ideas
    </p>
    <p class="captain-name">Siddhant Samar</p>
    <p class="captain-role">Team captain</p>
  </div>
  <div class="split-media">
    <div class="photo photo-lg">
      <img src="/realcaptain.jpeg" alt="Siddhant Samar" />
    </div>
  </div>
</section>

    <section class="stem-section partners-section" id="partners">
      <div class="partners-heading">
        <h2>Our Partners</h2>
        <p class="prose prose-center">
          Here are some of our partners helping make this possible
        </p>
      </div>
      <ul class="partner-grid">
        {partners.map((p) => (
          <li class="partner-card">
            {p.data.website ? (
              <a href={p.data.website} target="_blank" rel="noopener noreferrer" class="partner-link">
                <div class="partner-logo" aria-hidden="true">
                  {p.data.logo && <img src={p.data.logo} alt="" />}
                </div>
                <p class="partner-name">{p.data.name}</p>
                <p class="partner-blurb">{p.data.blurb}</p>
              </a>
            ) : (
              <>
                <div class="partner-logo" aria-hidden="true">
                  {p.data.logo && <img src={p.data.logo} alt="" />}
                </div>
                <p class="partner-name">{p.data.name}</p>
                <p class="partner-blurb">{p.data.blurb}</p>
              </>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="stem-section donate-section" id="donate">
      <div class="donate-heading">
        <h2>Send the next box</h2>
        <p class="prose prose-center">
          Every donation goes to materials and shipping. Nothing else.
        </p>
      </div>

      <div class="donate-card">
        <!--
          Paste your Zeffy embed here — its thermometer updates live
          with every gift. Get the snippet from your Zeffy dashboard
          under the campaign's sharing / embed settings.
        -->
        <div class="zeffy-slot">
          <div style="position:relative;overflow:hidden;width:100%;padding-top:90px;">
            <iframe
              title="Donation form powered by Zeffy"
              style="position:absolute;border:0;top:0;left:0;bottom:0;right:0;width:100%;height:90px"
              src="https://www.zeffy.com/embed/thermometer/stem-seeds"
              allowTransparency="true"
            ></iframe>
          </div>
        </div>

        <a class="button" href="https://www.zeffy.com/" target="_blank" rel="noopener">
          Donate to STEM Seeds
        </a>
      </div>
    </section>
  </StemRail>
</Layout>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    background: var(--tint);
    padding: 5rem 0 6.5rem;
    border-bottom: 1px solid var(--color-silver-light);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3rem;
    align-items: center;
  }
  .hero-photo-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    max-width: 26rem;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid var(--color-silver-light);
    overflow: hidden;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-photo-caption {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary-deep);
    margin: 0;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 600;
    color: var(--color-primary-deep);
  }
  .hero-lede {
    margin: 1.5rem 0 0;
    font-size: 1.1rem;
    max-width: 34rem;
    color: var(--color-dark);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  /* the sprout that the page's stem grows out of */
  .hero-sprout {
    position: absolute;
    left: 50%;
    transform: translateX(-31rem);
    bottom: -1px;
    width: 80px;
    height: 60px;
    fill: none;
    stroke: var(--color-secondary);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  @media (max-width: 1040px) {
    .hero-sprout { display: none; }
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-photo-block { order: -1; }
    .hero-photo { max-width: 20rem; }
  }

  /* ---------- shared ---------- */
  .button {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .button:hover { background: var(--color-primary-deep); }
  .button-quiet {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--color-silver);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .button-quiet:hover { border-color: var(--color-primary); }

  /* ---------- alternating split sections ---------- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    align-items: center;
  }
  /* reversed: media column moves to the left, text to the right */
  .split-reverse .split-text { order: 2; }
  .split-reverse .split-media { order: 1; }

  .split-media {
    position: relative;
    min-height: 15rem;
  }
  .photo {
    background: var(--tint);
    border: 1px solid var(--color-silver-light);
    border-radius: 90%;
  }
  .photo-lg {
    width: 13rem;
    height: 13rem;
    margin-left: auto;
  }

 .photo {
  overflow: hidden;
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 10%; /* shifts the visible crop down */

  }

  /* second, smaller circle offset from the first — echoes the
     staggered circles in the original wireframe */
  .photo-sm {
    width: 7.5rem;
    height: 7.5rem;
    position: absolute;
    left: 0.5rem;
    bottom: -1.5rem;
  }
  .split-reverse .photo-lg { 
    margin-left: 0;
     width: 15rem;
    height: 15rem;
  }

  .split-reverse {
    gap: 2rem;
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .split-reverse .split-text { order: 1; }
    .split-reverse .split-media { order: 2; }
    .split-media { min-height: 0; }
    .photo-lg { width: 10rem; height: 10rem; margin-left: 0; }
    .photo-sm { display: none; }
  }

  .prose {
    max-width: 38rem;
    margin: 1rem 0 0;
  }
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .stat-line {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--color-silver-dark);
  }
  .stat-line strong {
    color: var(--color-secondary);
    font-size: 1.15rem;
  }
  .stat-line a { color: var(--color-primary); }

  /* ---------- captain ---------- */
  .captain-name {
    margin: 1.5rem 0 0;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .captain-role {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--color-silver-dark);
  }

  /* ---------- partners ---------- */
  .partners-heading {
    text-align: center;
    max-width: 32rem;
    margin: 0 auto;
  }
  .partner-grid {
    list-style: none;
    padding: 0;
    margin: 2.25rem auto 0;
    max-width: 40rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    justify-content: center;
  }
  .partner-card {
    border: 1px solid var(--color-silver-light);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
  }
 .partner-logo {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--color-silver-light);
  margin: 0 auto 0.75rem;
  overflow: hidden;
}
.partner-logo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}
  .partner-name {
  margin: 0 0 0.35rem;
  font-weight: 700;
  }
  .partner-blurb {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-silver-dark);
  }
  .partner-link:hover .partner-name {
    color: var(--color-primary);
  }

  .partner-link {
  display: block;
  color: inherit;
  text-decoration: none;
  }

  /* ---------- alternating section backgrounds ---------- */
  /* Every other section along the stem gets a full-bleed tinted
     background that spans the entire viewport width — not just the
     content column — with the rail rendered on top of it (z-index
     on .stem-track / .stem-section::before in StemRail.astro).
     The ::after here is what actually bleeds edge-to-edge; z-index:-1
     keeps it behind normal in-flow text automatically, and the rail's
     explicit z-index keeps it above this regardless of DOM order. */
  .stem-section {
    position: relative;
  }
  .stem-section:nth-of-type(even)::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--tint);
    z-index: -1;
  }

  /* ---------- donate ---------- */
  .donate-heading {
    text-align: center;
    max-width: 32rem;
    margin: 0 auto;
  }
  .prose-center {
    margin-left: auto;
    margin-right: auto;
  }
  .donate-card {
    margin-top: 2rem;
    margin-left: auto;
    margin-right: auto;
    max-width: 22rem;
  }
  
  .zeffy-slot {
    border-radius: 12px;
    overflow: hidden;
    max-width: 26rem;
    margin: 0 auto;
    background: #ffffff;
    border: 1px solid var(--color-secondary);
    box-shadow: 0 0 0 3px rgba(46, 125, 79, 0.12);
    padding: 1.25rem 1.25rem 0;
}
  
  .zeffy-slot:hover {
    border-color: var(--color-secondary);
    box-shadow: 0 0 0 3px rgba(46, 125, 79, 0.12);
    cursor: default;
  }

  .zeffy-slot p { margin: 0; }
  .donate-card .button {
    display: block;
    text-align: center;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .donate-card {
      max-width: none;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ExpandableRow from '../components/ExpandableRow.astro';

const boxes = (await getCollection('boxes')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="STEM Boxes">
  <section class="page-intro">
    <div class="container">
      <h1>What's in a STEM box</h1>
      <p class="lede">
        Each box is self-contained — everything a kid needs for a set of
        hands-on projects, with no lab, no internet, and no prior experience
        assumed.
      </p>
    </div>
  </section>

  <div class="container box-list">
    {boxes.map((box) => (
      <ExpandableRow
        title={box.data.title}
        status={box.data.status}
        summary={box.data.summary}
        focus={box.data.focus}
        contents={box.data.contents}
        potentialUses={box.data.potentialUses}
        image={box.data.image}
        startExpanded={box.data.flagship}
      />
    ))}
  </div>
</Layout>

<style>
  .page-intro {
    background: var(--tint);
    padding: 4rem 0;
    border-bottom: 1px solid var(--color-silver-light);
  }
  .page-intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-primary-deep);
    max-width: 20ch;
  }
  .lede {
    margin: 1.25rem 0 0;
    font-size: 1.05rem;
    max-width: 36rem;
  }
  .box-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 3rem;
  }
</style>

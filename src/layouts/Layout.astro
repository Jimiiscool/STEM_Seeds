---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · STEM Seeds</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Nunito+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21V10" />
            <path d="M12 12C12 7 15 4 20 4c0 5-3 8-8 8Z" />
            <path d="M12 16c-4 0-6-2.5-6-6.5 4 0 6 2.5 6 6.5Z" />
          </svg>
          STEM Seeds
        </a>
        <nav>
          <a href="/">Home</a>
          <a href="/boxes">Boxes</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <p class="brand-name">STEM Seeds</p>
          <p class="tagline">Hands-on science kits for kids who've never had one.</p>
        </div>
        <div class="footer-col">
          <span class="col-heading">Explore</span>
          <a href="/">Home</a>
          <a href="/boxes">Boxes</a>
        </div>
        <div class="footer-col">
          <span class="col-heading">Connect</span>
          <a href="mailto:Ftcvanguard32737@gmail.com">Contact us</a>
          <a href="/#donate" class="donate-link">Donate</a>
          <div class="socials">
            <a href="https://www.instagram.com/ftcvanguardrobotics/" aria-label="Instagram">Instagram</a>
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} STEM Seeds — a university robotics team initiative.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-primary: #8A2BE2;
    --color-primary-deep: #5c1a99;
    --color-secondary: #556B2F;
    --color-dark: #1a1a1a;
    --color-silver: #9370DB;
    --color-silver-light: #f3eefa;
    --color-silver-dark: #7a5ba3;
    --tint: #dcbff6;

    --font-display: "Fraunces", Georgia, serif;
    --font-body: "Nunito Sans", system-ui, sans-serif;
    --rail: 3.25rem;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--color-dark);
    background: var(--color-bg);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .container {
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  a { color: inherit; }

  /* ---------- header ---------- */
  .site-header {
    border-bottom: 1px solid var(--color-silver-light);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
  }
  .brand-mark {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--color-secondary);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .site-header nav a {
    margin-left: 1.5rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-silver-dark);
  }

  .site-header nav a:hover { color: var(--color-primary); }

  /* ---------- footer ---------- */
  .site-footer {
    border-top: 1px solid var(--color-silver-light);
    padding: 2.5rem 0 1.5rem;
    margin-top: 5rem;
    background: var(--tint);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0 0 0.25rem;
  }
  .tagline {
    font-size: 0.85rem;
    color: var(--color-silver-dark);
    max-width: 16rem;
    margin: 0;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.875rem;
  }
  .footer-col a { text-decoration: none; }
  .footer-col a:hover { color: var(--color-primary); }
  .col-heading {
    font-size: 0.8rem;
    color: var(--color-silver-dark);
    margin-bottom: 0.2rem;
  }
  .donate-link {
    color: var(--color-secondary);
    font-weight: 600;
  }
  .socials {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.2rem;
    font-size: 0.8rem;
  }
  .footer-bottom {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-silver);
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-silver-dark);
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 3px;
  }
</style>

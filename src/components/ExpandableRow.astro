---
// Shared "expandable row" component for the STEM Boxes page.
// Collapsed: thumbnail, title, status badge, one-line summary.
// Expanded: adds Focus / Contents / Potential uses, stacked.
//
// Pure CSS + a tiny script for the expand/collapse state —
// no framework needed for something this simple.

interface Props {
  title: string;
  status: 'available' | 'coming-soon';
  summary: string;
  focus: string;
  contents: string;
  potentialUses: string;
  image?: string;
  startExpanded?: boolean;
}

const {
  title,
  status,
  summary,
  focus,
  contents,
  potentialUses,
  image,
  startExpanded = false,
} = Astro.props;

const statusLabel = status === 'available' ? 'Available' : 'Coming soon';
---

<div class:list={['row', { muted: status === 'coming-soon' }]} data-expanded={startExpanded}>
  <button class="row-header" type="button" aria-expanded={startExpanded}>
    <div class="thumb" aria-hidden="true">
      {image && <img src={image} alt="" />}
    </div>
    <div class="header-text">
      <div class="title-line">
        <span class="title">{title}</span>
        <span class:list={['badge', status]}>{statusLabel}</span>
      </div>
      {!startExpanded && <p class="summary">{summary}</p>}
    </div>
    <span class="chevron" aria-hidden="true">{startExpanded ? '▲' : '▼'}</span>
  </button>

  <div class="details" hidden={!startExpanded}>
    <div class="field">
      <p class="field-label">Focus</p>
      <p class="field-value">{focus}</p>
    </div>
    <div class="field">
      <p class="field-label">Contents</p>
      <p class="field-value">{contents}</p>
    </div>
    <div class="field">
      <p class="field-label">Potential uses</p>
      <p class="field-value">{potentialUses}</p>
    </div>
  </div>
</div>

<style>
  .row {
    border: 1px solid #e2e2e2;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .row.muted {
    opacity: 0.6;
  }
  .row-header {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 1rem;
    cursor: pointer;
  }
  .thumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 8px;
    background: #f0f0f0;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .header-text {
    flex: 1;
    min-width: 0;
  }
  .title-line {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .title {
    font-size: 15px;
    font-weight: 500;
  }
  .badge {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .badge.available {
    background: #e3f5e6;
    color: #1c7a34;
  }
  .badge.coming-soon {
    background: #f0f0f0;
    color: #888;
  }
  .summary {
    margin: 4px 0 0;
    font-size: 13px;
    color: #666;
  }
  .chevron {
    color: #888;
    font-size: 14px;
  }
  .details {
    padding: 0 1.25rem 1.25rem;
    border-top: 1px solid #eee;
    display: grid;
    gap: 10px;
    padding-top: 12px;
  }
  .field-label {
    margin: 0 0 4px;
    font-size: 13px;
    color: #666;
  }
  .field-value {
    margin: 0;
    font-size: 14px;
  }
</style>

<script>
  // Small, dependency-free expand/collapse. Runs client-side after
  // the static HTML has already rendered (progressive enhancement —
  // the collapsed summary is still visible even if JS fails to load).
  document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
    const header = row.querySelector<HTMLButtonElement>('.row-header');
    const details = row.querySelector<HTMLElement>('.details');
    const chevron = row.querySelector<HTMLElement>('.chevron');
    const summary = row.querySelector<HTMLElement>('.summary');
    if (!header || !details || !chevron) return;

    header.addEventListener('click', () => {
      const expanded = header.getAttribute('aria-expanded') === 'true';
      header.setAttribute('aria-expanded', String(!expanded));
      details.hidden = expanded;
      chevron.textContent = expanded ? '▼' : '▲';
      if (summary) summary.style.display = expanded ? '' : 'none';
    });
  });
</script>

---
// Shared expand/collapse row for the STEM Boxes page.
// Available boxes: clickable, expand to show Focus / Contents / Potential uses.
// Coming-soon boxes: static, non-interactive — no expand behavior at all.

interface Props {
  title: string;
  status: 'available' | 'coming-soon';
  summary: string;
  focus: string;
  contents: string;
  potentialUses: string;
  image?: string;
  startExpanded?: boolean;
}

const {
  title,
  status,
  summary,
  focus,
  contents,
  potentialUses,
  image,
  startExpanded = false,
} = Astro.props;

const isComingSoon = status === 'coming-soon';
const statusLabel = isComingSoon ? 'Coming soon' : 'Available';
---

<article class:list={['row', { muted: isComingSoon }]}>
  {isComingSoon ? (
    <div class="row-header row-header-static">
      <span class="thumb" aria-hidden="true">
        {image && <img src={image} alt="" />}
      </span>
      <span class="header-text">
        <span class="title-line">
          <span class="title">{title}</span>
          <span class:list={['badge', status]}>{statusLabel}</span>
        </span>
        <span class="summary">{summary}</span>
      </span>
    </div>
  ) : (
    <>
      <button class="row-header" type="button" aria-expanded={startExpanded}>
        <span class="thumb" aria-hidden="true">
          {image && <img src={image} alt="" />}
        </span>
        <span class="header-text">
          <span class="title-line">
            <span class="title">{title}</span>
            <span class:list={['badge', status]}>{statusLabel}</span>
          </span>
          <span class="summary">{summary}</span>
        </span>
        <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 6l4 4 4-4" />
        </svg>
      </button>

      <div class="details-outer" data-open={startExpanded ? 'true' : 'false'}>
        <div class="details">
          <div class="field">
            <p class="field-label">Focus</p>
            <p class="field-value">{focus}</p>
          </div>
          <div class="field">
            <p class="field-label">What's inside</p>
            <p class="field-value">{contents}</p>
          </div>
          <div class="field">
            <p class="field-label">What you can build</p>
            <p class="field-value">{potentialUses}</p>
          </div>
        </div>
      </div>
    </>
  )}
</article>

<style>
  .row {
    border: 1px solid var(--color-silver-light);
    border-radius: 14px;
    background: var(--color-bg);
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .row:hover { border-color: var(--color-silver); }
  .row:has(.row-header[aria-expanded='true']) {
    border-color: var(--color-silver);
    box-shadow: 0 1px 2px rgba(23, 20, 25, 0.04);
  }
  .row.muted { opacity: 0.72; }

  .row-header {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
  }
  .row-header-static {
    cursor: default;
  }

  .thumb {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 10px;
    background: var(--tint);
    overflow: hidden;
    display: block;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }

  .header-text {
    flex: 1;
    min-width: 0;
    display: block;
  }
  .title-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
  .badge.available {
    background: rgba(46, 125, 79, 0.1);
    color: var(--color-secondary);
  }
  .badge.coming-soon {
    background: var(--color-silver-light);
    color: var(--color-silver-dark);
  }
  .summary {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--color-silver-dark);
  }

  .chevron {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.8;
    stroke-linecap: round;
    transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .row-header[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  /* Grid-rows trick: animates cleanly from 0 to auto height. */
  .details-outer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 260ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .details-outer[data-open='true'] {
    grid-template-rows: 1fr;
  }
  .details {
    overflow: hidden;
  }
  .details > .field:first-child {
    border-top: 1px solid var(--color-silver-light);
    padding-top: 1.1rem;
  }
  .field {
    padding: 0 1.25rem 1.1rem;
  }
  .details > .field:first-child {
    margin: 0 1.25rem;
    padding-left: 0;
    padding-right: 0;
  }
  .field-label {
    margin: 0 0 0.15rem;
    font-size: 0.8rem;
    color: var(--color-secondary);
    font-weight: 600;
  }
  .field-value {
    margin: 0;
    font-size: 0.95rem;
    max-width: 40rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .details-outer, .chevron, .row { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
    const header = row.querySelector<HTMLButtonElement>('.row-header');
    const outer = row.querySelector<HTMLElement>('.details-outer');
    if (!header || !outer) return;

    header.addEventListener('click', () => {
      const open = header.getAttribute('aria-expanded') === 'true';
      header.setAttribute('aria-expanded', String(!open));
      outer.dataset.open = String(!open);
    });
  });
</script>